# NPMplus Development Environment Variables
# Copy this file to .env and adjust values as needed

# Database Configuration (defaults to SQLite if not set)
# DB_MYSQL_HOST=localhost
# DB_MYSQL_PORT=3306
# DB_MYSQL_USER=npmplus
# DB_MYSQL_PASSWORD=secret
# DB_MYSQL_NAME=npmplus
# DB_MYSQL_TLS=false
# DB_MYSQL_CA=/etc/ssl/certs/ca-certificates.crt

# DB_POSTGRES_HOST=localhost
# DB_POSTGRES_PORT=5432
# DB_POSTGRES_USER=npmplus
# DB_POSTGRES_PASSWORD=secret
# DB_POSTGRES_NAME=npmplus

# ACME/Let's Encrypt Configuration
ACME_EMAIL=dev@example.com
# ACME_SERVER=https://acme-v02.api.letsencrypt.org/directory
# ACME_EAB_KID=
# ACME_EAB_HMAC_KEY=
# ACME_MUST_STAPLE=false
# ACME_OCSP_STAPLING=false
# ACME_PROFILE=
# ACME_KEY_TYPE=ecdsa
# ACME_SERVER_TLS_VERIFY=true

# Server Configuration
TZ=UTC
# NPM_PORT=81
# GOA_PORT=91
# HTTP_PORT=80
# HTTPS_PORT=443
# HTTP3_ALT_SVC_PORT=443

# IP Binding (for development, usually localhost)
# IPV4_BINDING=127.0.0.1
# NPM_IPV4_BINDING=127.0.0.1
# GOA_IPV4_BINDING=127.0.0.1
# DISABLE_IPV6=false

# Feature Toggles
# LOGROTATE=false
# LOGROTATIONS=3
# GOA=false
# FULLCLEAN=false
# DISABLE_HTTP=false
# DISABLE_H3_QUIC=false
# NGINX_QUIC_BPF=false
# NGINX_LOG_NOT_FOUND=false
# NGINX_404_REDIRECT=false
# NGINX_DISABLE_PROXY_BUFFERING=false

# Initial Admin Setup (first run only)
# INITIAL_ADMIN_EMAIL=admin@example.org
# INITIAL_ADMIN_PASSWORD=
# INITIAL_DEFAULT_PAGE=congratulations

# Advanced
# PUID=0
# PGID=0
# DEBUG=true
# SKIP_IP_RANGES=true
# IPRT=1
# CRT=23
# ENABLE_PRERUN=false

# PHP (if needed for development)
# PHP82=false
# PHP83=false
# PHP84=false

# Modules
# NGINX_LOAD_OPENAPPSEC_ATTACHMENT_MODULE=false
# NGINX_LOAD_OPENTELEMETRY_MODULE=false
# NGINX_LOAD_GEOIP2_MODULE=false
# NGINX_LOAD_NJS_MODULE=false
# NGINX_LOAD_NTLM_MODULE=false
# NGINX_LOAD_VHOST_TRAFFIC_STATUS_MODULE=false
